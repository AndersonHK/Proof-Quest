{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Quest dataset v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "question_bank": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "timings": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "file",
            "timings"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "chapters",
    "question_bank"
  ]
}
