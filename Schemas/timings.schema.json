{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Quest timings v1",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "voice": {
      "type": "string"
    },
    "rate": {
      "type": "string"
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "sentence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "start",
          "end",
          "start_ms",
          "end_ms",
          "sentence"
        ]
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "first_word": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "start",
          "end",
          "start_ms",
          "first_word"
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "title",
          "start_ms"
        ]
      }
    }
  },
  "required": [
    "text",
    "duration_ms",
    "words",
    "sentences"
  ]
}
