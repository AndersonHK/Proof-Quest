{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Quest questions v1",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "chapter": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "correct": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "wrong": {
            "type": "array",
            "minItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer_format": {
            "type": "string",
            "enum": [
              "number",
              "set",
              "truth_column",
              "complexity",
              "property_list"
            ]
          },
          "distractor_sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "id",
          "chapter",
          "topic",
          "family",
          "source",
          "prompt",
          "explanation",
          "correct",
          "wrong"
        ]
      }
    }
  },
  "required": [
    "version",
    "questions"
  ]
}
